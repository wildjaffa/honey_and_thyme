# Lightweight Docker image for React app
FROM nginx:alpine

# Copy the built React app to nginx's html directory
# Note: The build happens in the GitHub Action before this step
COPY honey-and-thyme/dist /usr/share/nginx/html

# Copy custom nginx configuration
COPY nginx-react.conf /etc/nginx/nginx.conf

# Copy the env.sh script that generates config.js at runtime
COPY env.sh /docker-entrypoint.d/40-generate-config.sh
RUN chmod +x /docker-entrypoint.d/40-generate-config.sh

# Expose port 80
EXPOSE 80

# The nginx:alpine image automatically executes scripts in /docker-entrypoint.d/
# before starting nginx, so our env.sh will run automatically
CMD ["nginx", "-g", "daemon off;"]
